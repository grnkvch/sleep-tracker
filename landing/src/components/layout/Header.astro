---
import Button from '../common/Button.astro';
import Container from '../common/Container.astro';
import type { LaunchConfig } from '../../config/content-schema';

interface Props {
  copy: {
    logoLabel: string;
    benefitsLink: string;
    productLink: string;
    cta: string;
  };
  launch: LaunchConfig;
}

const { copy, launch } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <Container class="site-header__inner">
    <a class="brand-mark" href={base} aria-label={copy.logoLabel}>
      <svg aria-hidden="true" viewBox="0 0 48 48" width="40" height="40">
        <path
          d="M9 30c5-13 18-20 30-12"
          fill="none"
          stroke="currentColor"
          stroke-width="5"
          stroke-linecap="round"></path>
        <circle cx="34" cy="27" r="5" fill="currentColor"></circle>
      </svg>
    </a>
    <nav class="site-header__nav" aria-label={copy.logoLabel}>
      <a href={`${base}#benefits`}>{copy.benefitsLink}</a>
      <a href={`${base}#product-demo`}>{copy.productLink}</a>
    </nav>
    <Button href="#offer" variant="quiet" placement="header" channel={launch.primary.channel}>
      {copy.cta}
    </Button>
  </Container>
</header>
