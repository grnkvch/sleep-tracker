---
interface Props {
  steps: string[];
  summary: string;
}

const { steps, summary } = Astro.props;
---

<figure class="onboarding-steps" aria-labelledby="onboarding-caption">
  <figcaption id="onboarding-caption">{summary}</figcaption>
  <ol>
    {
      steps.map((step, index) => (
        <li>
          <>
            <span>{index + 1}</span>
            <p>{step}</p>
          </>
        </li>
      ))
    }
  </ol>
</figure>
