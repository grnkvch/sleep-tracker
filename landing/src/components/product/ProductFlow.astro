---
import ProductStepVisual from './ProductStepVisual.astro';
import type { DemoContent } from '../../config/content-schema';

interface Step {
  number: string;
  visual: 'profile' | 'sleep' | 'recommendation';
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  summary: string;
  demo: DemoContent;
}

const { steps, summary, demo } = Astro.props;
---

<figure class="product-flow" aria-labelledby="product-flow-caption">
  <figcaption id="product-flow-caption">{summary}</figcaption>
  <ol>
    {
      steps.map((step) => (
        <li>
          <div class="product-flow__copy">
            <span class="product-flow__number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
          <ProductStepVisual variant={step.visual} demo={demo} />
        </li>
      ))
    }
  </ol>
</figure>
