---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/common/Container.astro';

interface Props {
  title: string;
  description: string;
  backLabel: string;
}

const { title, description, backLabel } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={title}
  description={description}
  profile={__LAUNCH_PROFILE__}
  mode={__BUILD_MODE__}
>
  <main class="legal-page">
    <Container>
      <a class="legal-page__back" href={base}>← {backLabel}</a>
      <article class="legal-content"><slot /></article>
    </Container>
  </main>
</BaseLayout>
